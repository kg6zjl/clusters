{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": true,
  "prConcurrentLimit": 1,
  "enabledManagers": [
    "helmfile",
    "helm-values",
    "flux",
    "kubernetes",
    "custom.regex",
    "dockerfile",
    "github-actions"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "trufflehog CLI pin in the CI workflow, where the Secret Scan fallback reads it",
      "managerFilePatterns": [
        "/^\\.github/workflows/ci\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\s*(?:\\r?\\n)+\\s*TRUFFLEHOG_VERSION: \"(?<currentValue>.*?)\""
      ]
    },
    {
      "customType": "regex",
      "description": "trufflehog CLI pin in the node-local cache warmer DaemonSet",
      "managerFilePatterns": [
        "/^home-cluster/github-runners/toolcache-warmer\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\s*(?:\\r?\\n)+\\s*- name: TRUFFLEHOG_VERSION\\s*(?:\\r?\\n)+\\s*value: \"(?<currentValue>.*?)\""
      ]
    },
    {
      "customType": "regex",
      "description": "Kyverno CLI pin in the CI workflow, where the policy-test fallback reads it",
      "managerFilePatterns": [
        "/^\\.github/workflows/ci\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\s*(?:\\r?\\n)+\\s*KYVERNO_VERSION: \"(?<currentValue>.*?)\""
      ]
    },
    {
      "customType": "regex",
      "description": "Kyverno CLI pin in the node-local cache warmer DaemonSet",
      "managerFilePatterns": [
        "/^home-cluster/github-runners/toolcache-warmer\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\s*(?:\\r?\\n)+\\s*- name: KYVERNO_VERSION\\s*(?:\\r?\\n)+\\s*value: \"(?<currentValue>.*?)\""
      ]
    },
    {
      "customType": "regex",
      "description": "promtool pin in the CI workflow, where the alerting rule check reads it",
      "managerFilePatterns": [
        "/^\\.github/workflows/ci\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\s*(?:\\r?\\n)+\\s*PROMETHEUS_VERSION: \"(?<currentValue>.*?)\""
      ]
    },
    {
      "customType": "regex",
      "description": "promtool pin in the node-local cache warmer DaemonSet",
      "managerFilePatterns": [
        "/^home-cluster/github-runners/toolcache-warmer\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\s*(?:\\r?\\n)+\\s*- name: PROMETHEUS_VERSION\\s*(?:\\r?\\n)+\\s*value: \"(?<currentValue>.*?)\""
      ]
    },
    {
      "customType": "regex",
      "description": "amtool pin in the CI workflow, where the alerting config check reads it",
      "managerFilePatterns": [
        "/^\\.github/workflows/ci\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\s*(?:\\r?\\n)+\\s*ALERTMANAGER_VERSION: \"(?<currentValue>.*?)\""
      ]
    },
    {
      "customType": "regex",
      "description": "amtool pin in the node-local cache warmer DaemonSet",
      "managerFilePatterns": [
        "/^home-cluster/github-runners/toolcache-warmer\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\s*(?:\\r?\\n)+\\s*- name: ALERTMANAGER_VERSION\\s*(?:\\r?\\n)+\\s*value: \"(?<currentValue>.*?)\""
      ]
    },
    {
      "customType": "regex",
      "description": "node_exporter release pin in the Beast exporter bootstrap script",
      "managerFilePatterns": [
        "/^home-cluster/ai-services/scripts/beast-exporters\\.sh$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\s*(?:\\r?\\n)+\\s*NODE_EXPORTER_VERSION=\"(?<currentValue>.*?)\""
      ]
    },
    {
      "customType": "regex",
      "description": "nvidia_gpu_exporter release pin in the Beast exporter bootstrap script",
      "managerFilePatterns": [
        "/^home-cluster/ai-services/scripts/beast-exporters\\.sh$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\s*(?:\\r?\\n)+\\s*GPU_EXPORTER_VERSION=\"(?<currentValue>.*?)\""
      ]
    }
  ],
  "flux": {
    "managerFilePatterns": [
      "/^home-cluster\\/.+helmrelease.*\\.ya?ml$/",
      "/^home-cluster\\/.+helmrepository\\.ya?ml$/",
      "/^home-cluster\\/.+ocirepository\\.ya?ml$/",
      "/^home-cluster\\/flux-system\\/gotk-components\\.yaml$/",
      "/^home-cluster\\/flux-notifications\\/alert\\.ya?ml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/home-cluster/.+\\.ya?ml$/"
    ]
  },
  "constraints": {
    "helm": "^3.15.0"
  },
  "packageRules": [
    {
      "matchManagers": [
        "helmfile"
      ],
      "constraints": {
        "helm": "^3.15.0"
      }
    },
    {
      "description": "gotk-components.yaml is generated by `flux install` and carries the Flux controllers AND their CRDs, which must move together. Per-image bumps here produce an unsupported mix of controller versions against a stale distro's CRDs. Upgrade the distro as a whole instead. Both the kubernetes and flux managers read this file, so the rule has to name both - scoped to one, the other manager's bumps go through unblocked.",
      "matchManagers": [
        "kubernetes",
        "flux"
      ],
      "matchFileNames": [
        "home-cluster/flux-system/gotk-components.yaml"
      ],
      "enabled": false
    },
    {
      "description": "Longhorn is the storage engine. A chart bump rolls longhorn-manager and recreates volume engines, and an engine recreated under a live pod leaves the kubelet's node-side mount behind - the pod then wedges until someone clears it on that node (documentation/longhorn-migration.md section 8). It is the one dependency whose rollout can touch every mounted volume, so it waits for an explicit tick on the dashboard instead of arriving as routine PR noise.",
      "matchManagers": [
        "flux"
      ],
      "matchFileNames": [
        "home-cluster/longhorn-system/longhorn-helmrelease.yaml"
      ],
      "dependencyDashboardApproval": true,
      "minimumReleaseAge": "7 days",
      "addLabels": [
        "maintenance-window"
      ],
      "prBodyNotes": [
        "### Storage engine - merge inside a maintenance window",
        "This rolls `longhorn-manager` and recreates volume engines. An engine recreated under a live pod leaves the kubelet's node-side mount behind, and that pod stays Pending until the mount is cleared (see `documentation/longhorn-migration.md` section 8). Merge it when you can watch the result, then confirm nothing stuck:",
        "```",
        "kubectl get pods -A --field-selector=status.phase=Pending",
        "kubectl -n longhorn-system get volumes.longhorn.io -o custom-columns=NAME:.metadata.name,STATE:.status.state,ROBUST:.status.robustness,NODE:.status.currentNodeID",
        "```",
        "The `kubelet-csi-mount-janitor` timer clears a leaked mount on its own once its mode is `enforce`."
      ]
    }
  ]
}
