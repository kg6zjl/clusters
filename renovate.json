{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": true,
  "prConcurrentLimit": 1,
  "enabledManagers": ["helmfile", "helm-values", "flux", "kubernetes", "custom.regex"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "trufflehog CLI pin in the CI workflow, where the Secret Scan fallback reads it",
      "managerFilePatterns": ["/^\\.github/workflows/ci\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\s*(?:\\r?\\n)+\\s*TRUFFLEHOG_VERSION: \"(?<currentValue>.*?)\""
      ]
    },
    {
      "customType": "regex",
      "description": "trufflehog CLI pin in the node-local cache warmer DaemonSet",
      "managerFilePatterns": ["/^home-cluster/github-runners/toolcache-warmer\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\s*(?:\\r?\\n)+\\s*- name: TRUFFLEHOG_VERSION\\s*(?:\\r?\\n)+\\s*value: \"(?<currentValue>.*?)\""
      ]
    }
  ],
  "flux": {
    "fileMatch": ["home-cluster/[^/]+/helmrelease\\.yaml$"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/home-cluster/.+\\.ya?ml$/"]
  },
  "constraints": {
    "helm": "^3.15.0"
  },
  "packageRules": [
    {
      "matchManagers": ["helmfile"],
      "constraints": {
        "helm": "^3.15.0"
      }
    },
    {
      "description": "gotk-components.yaml is generated by `flux install` and carries the Flux controllers AND their CRDs, which must move together. Per-image bumps here produce an unsupported mix of controller versions against a stale distro's CRDs. Upgrade the distro as a whole instead.",
      "matchManagers": ["kubernetes"],
      "matchFileNames": ["home-cluster/flux-system/gotk-components.yaml"],
      "enabled": false
    }
  ]
}
