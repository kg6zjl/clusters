#!/usr/bin/env bash
# Clears the CSI staging mount a Longhorn engine restart leaves behind on a node - the
# wedge in documentation/longhorn-migration.md section 8. Enforce mode is opt-in.
set -uo pipefail

MODE="{{ csi_mount_janitor_mode }}"

# Anchored to the kubelet CSI plugin dir and a 64-hex volume handle, so nothing else can
# match. The path is read from the mount table itself, never from a pod event or a name.
PATTERN='^/var/snap/microk8s/common/var/lib/kubelet/plugins/kubernetes\.io/csi/driver\.longhorn\.io/[0-9a-f]{64}/globalmount$'

log() { logger -t kubelet-csi-mount-janitor -- "$*"; }

# `|| true` matters under `set -o pipefail`: `grep` exits 1 when nothing matches, and that
# would otherwise fail the whole script before the empty-targets guard is reached.
mapfile -t targets < <(findmnt -rn -o TARGET 2>/dev/null | grep -E "$PATTERN" || true)

if [ "${#targets[@]}" -eq 0 ]; then
  exit 0
fi

for target in "${targets[@]}"; do
  handle=$(basename "$(dirname "$target")")
  device=$(findmnt -rn -o SOURCE --target "$target" 2>/dev/null)

  if [ -z "$device" ]; then
    # The directory exists but nothing is mounted on it. That is the leftover this script is
    # here to clear, but `umount` would fail on it -- there is no mount to release. Removing
    # the empty staging directory is what lets the CSI plugin recreate it on the next
    # NodePublishVolume.
    if [ "$MODE" != "enforce" ]; then
      log "report: would remove empty staging dir ${target}"
      continue
    fi
    if rmdir "$target" 2>/dev/null; then
      log "removed empty staging dir ${target} (volume ${handle})"
    else
      log "staging dir not empty, left for a human: ${target}"
    fi
    continue
  fi

  # THE SAFETY GATE: is this volume still published to a live pod?
  #
  # The kubelet publishes a volume by bind-mounting the same device into
  # /var/lib/kubelet/pods/<uid>/volumes/.../mount. While that bind mount exists, the kubelet
  # still considers the volume published and a pod may be using it, so never touch it.
  #
  # Prefer this over `fuser -m` as the primary gate. `fuser -m` matches on st_dev and does look
  # across mount namespaces, but it answers "does a holder have a handle open at this instant",
  # not "is this volume published". A healthy pod with no open handle on the volume looks
  # identical to a leak. Measured on thinkcentre01 against one live `media/prowlarr` volume
  # (pod Running 1/1 throughout, container process alive, 391 namespaces with the device
  # mounted): `fuser -m` reported 1 pid in one session, then 0 in 10/10, 40/40 and 15/15 samples
  # across later sessions, while this bind mount stayed a stable 1. That instability is exactly
  # what makes `fuser` unsafe as the gate: the count flips with holder I/O timing, so a healthy
  # volume intermittently looks leaked. The kubelet's own bind mount is the durable signal.
  published=$(awk -v dev="$device" '$1 == dev && $2 ~ /\/pods\// { n++ } END { print n + 0 }' /proc/mounts 2>/dev/null)

  if [ "${published:-0}" -gt 0 ]; then
    log "still published to a pod (${published} bind mount(s)), skipping ${target}"
    continue
  fi

  # Belt and braces, not the gate: a host-level process (registry, a node daemon) with an open
  # handle is also a reason to leave it alone.
  in_use=$(fuser -m "$target" 2>/dev/null | tr -s ' ' '\n' | grep -cE '^[0-9]+$' || true)

  if [ "${in_use:-0}" -gt 0 ]; then
    log "in use by ${in_use} host pid(s), skipping ${target}"
    continue
  fi

  if [ "$MODE" != "enforce" ]; then
    log "report: would umount leaked staging mount ${target} (device ${device})"
    continue
  fi

  if umount "$target"; then
    log "umounted leaked staging mount ${target} (device ${device})"
  else
    log "umount failed, left for a human: ${target}"
  fi
done
