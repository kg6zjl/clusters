#!/bin/sh
# Run pre-commit (if installed and configured) on every commit.
#
# Only active when core.hooksPath points at this .githooks directory and the
# repo has a .pre-commit-config.yaml. Silent no-op otherwise, so sharing
# hooksPath across clones/repos (as Hermes's global gitconfig does) is safe.

set -u

dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

# Rebase guard runs first and unconditionally: it needs no network and no
# pre-commit install, so a stale branch is caught on every commit (the guard
# scopes itself to this repo and fails open when it cannot judge).
"$dir/check-rebased-on-main.sh" || exit 1

if ! command -v pre-commit >/dev/null 2>&1; then
	exit 0
fi

top="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
[ -f "$top/.pre-commit-config.yaml" ] || exit 0

cd "$top" || exit 0
pre-commit run --hook-stage pre-commit
