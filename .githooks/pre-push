#!/bin/sh
# Enforce "branch is based on current origin/main" before pushing.
#
# Only active when core.hooksPath is configured to point at this .githooks
# directory (Hermes's mounted global gitconfig does this). Inert everywhere
# else — CI, other machines, and any repo that doesn't configure it.
#
# Why: pushing a branch that doesn't contain the latest main means the PR is
# stale on arrival; GitHub will refuse to merge it and the work gets redone.
# Failing here, at push time, catches it the cheapest way possible.

set -u

if [ "$#" -lt 1 ]; then
	exit 0
fi

remote_url="$(git remote get-url "$1" 2>/dev/null || echo "$1")"

# Scope to this repo so a shared hooksPath can't surprise other clones.
case "$remote_url" in
	*kg6zjl/clusters*|*github.com/kg6zjl/clusters.git) ;;
	*) exit 0 ;;
esac

# Refresh origin/main so the ancestry check uses current upstream state.
if ! git fetch --quiet "$1" main 2>/dev/null; then
	echo "pre-push: could not fetch origin/main (offline?) — skipping rebase check" >&2
	exit 0
fi

main_sha="$(git rev-parse origin/main 2>/dev/null)" || exit 0

while read -r local_ref local_sha remote_ref remote_sha; do
	case "$local_ref" in
		refs/heads/*) ;;
		*) continue ;;
	esac
	[ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
	branch="${local_ref#refs/heads/}"
	[ "$branch" = "main" ] && continue

	# If the common ancestor is origin/main's tip, the branch contains it.
	if ! base="$(git merge-base origin/main "$local_sha" 2>/dev/null)"; then
		# e.g. shallow clone / missing objects — don't guess, let it through.
		echo "pre-push: could not compute merge-base (shallow clone?) — skipping rebase check" >&2
		continue
	fi
	[ "$base" = "$main_sha" ] && continue

	echo "PUSH BLOCKED: branch '$branch' does not contain latest origin/main." >&2
	echo "" >&2
	echo "  Your PR would be stale and GitHub would refuse to merge it. Rebase first:" >&2
	echo "" >&2
	echo "    git fetch origin" >&2
	echo "    git rebase origin/main" >&2
	echo "" >&2
	echo "  Resolve any conflicts, commit, then push again." >&2
	exit 1
done

exit 0
