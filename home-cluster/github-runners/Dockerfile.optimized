# In-house runner image.
#
# Base is the first-party runner image, pinned by digest rather than a floating tag: the artifact
# that runs every CI job here should not be a third party's rebuild of the GitHub runner agent.
# actions/runner's current release is v2.337.0, which is the version this digest carries.
#
# The tooling below is exactly what this repo's workflows call: kubectl and kustomize (ci.yaml's
# Validate job) and yamllint (Lint). Trufflehog is deliberately absent -- it lives in the node-local
# toolcache that the runner-toolcache-warmer DaemonSet keeps warm, so baking it here would duplicate
# a solved problem. Every download is pinned by version and verified by checksum: an image build that
# silently picks up a new kubectl is how "it worked yesterday" starts.
FROM ghcr.io/actions/actions-runner@sha256:e5496277be5d09bc968b3d64911b74e219ac4a3f2edce956a3ecf9271bea1ef4

USER root

ARG KUBECTL_VERSION=v1.37.1
ARG KUBECTL_SHA256=65691ff77eb6fa44c908b77a1082c9f092c3b9733b5cefabec0d1104890e21a8
ARG KUSTOMIZE_VERSION=v5.8.1
ARG YAMLLINT_VERSION=1.38.0

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl python3 python3-venv; \
    rm -rf /var/lib/apt/lists/*

# kubectl: dl.k8s.io publishes the digest next to the binary.
RUN set -eux; \
    curl -fsSLo /usr/local/bin/kubectl \
      "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/amd64/kubectl"; \
    echo "${KUBECTL_SHA256}  /usr/local/bin/kubectl" | sha256sum -c -; \
    chmod +x /usr/local/bin/kubectl

# kustomize: the release ships a checksums.txt that covers the tarball.
RUN set -eux; \
    curl -fsSLo "/tmp/kustomize_${KUSTOMIZE_VERSION}_linux_amd64.tar.gz" \
      "https://github.com/kubernetes-sigs/kustomize/releases/download/kustomize%2F${KUSTOMIZE_VERSION}/kustomize_${KUSTOMIZE_VERSION}_linux_amd64.tar.gz"; \
    curl -fsSLo /tmp/kustomize-checksums.txt \
      "https://github.com/kubernetes-sigs/kustomize/releases/download/kustomize%2F${KUSTOMIZE_VERSION}/checksums.txt"; \
    cd /tmp; \
    grep "kustomize_${KUSTOMIZE_VERSION}_linux_amd64.tar.gz" kustomize-checksums.txt | sha256sum -c -; \
    tar -xzf "/tmp/kustomize_${KUSTOMIZE_VERSION}_linux_amd64.tar.gz" -C /usr/local/bin kustomize; \
    chmod +x /usr/local/bin/kustomize; \
    rm -f "/tmp/kustomize_${KUSTOMIZE_VERSION}_linux_amd64.tar.gz" /tmp/kustomize-checksums.txt

# yamllint goes in its own venv. The base image's python belongs to the distro, and installing into
# it with --break-system-packages is a habit that breaks the day the distro changes.
RUN set -eux; \
    python3 -m venv /opt/yamllint; \
    /opt/yamllint/bin/pip install --no-cache-dir "yamllint==${YAMLLINT_VERSION}"; \
    ln -sf /opt/yamllint/bin/yamllint /usr/local/bin/yamllint

USER runner

# Fail the build here rather than in a job that only finds out at 3am.
RUN kubectl version --client && kustomize version && yamllint --version
