flowchart LR
%% What is measured, and what a measurement is allowed to do about it.
%%
%% The solid-versus-dashed split is the part worth taking away. Scraped metrics can raise an
%% alert; an alert can reach a human or start an investigation. No path from a metric reaches the
%% cluster's desired state, because a number moving is not an opinion about what the cluster
%% should be.

  subgraph collect["collect"]
    nodeex["node exporter<br/>pressure stall,<br/>not load average"]
    kube["kube-state-metrics"]
    alloy["Grafana Alloy<br/>ships logs from every pod"]
    blackbox["blackbox-exporter<br/>probes each published name"]
  end

  prom[("Prometheus")]
  loki[("Loki<br/>hours, not weeks")]
  grafana["Grafana<br/>one dashboard per question"]
  rules["alert rules<br/>in git, reviewed like code"]

  nodeex --> prom
  kube --> prom
  blackbox --> prom
  alloy --> loki
  loki --> grafana
  prom --> grafana
  prom --> rules

  rules -->|"a rule fires"| am["Alertmanager"]
  am -.->|"never back into<br/>the cluster"| collect

  classDef store fill:#121820,stroke:#98a5b2,color:#e7edf3
  class prom,loki store
