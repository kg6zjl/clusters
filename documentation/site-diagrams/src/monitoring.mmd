flowchart LR
%% What is measured, and where that measurement is allowed to go. Nothing here writes to the
%% cluster — a number moving is not an opinion about what the cluster should be. Where a firing
%% alert goes next is the alerting page's story, not this one's.

  subgraph collect["collect"]
    nodeex["node exporter"]
    kube["kube-state-metrics"]
    blackbox["blackbox-exporter"]
    alloy["Grafana Alloy<br/>logs from every pod"]
  end

  prom[("Prometheus")]
  loki[("Loki")]
  grafana["Grafana"]
  am["Alertmanager"]

  nodeex --> prom
  kube --> prom
  blackbox --> prom
  alloy --> loki

  loki --> grafana
  prom --> grafana
  prom -->|"fires"| am

  %% Stores are grey and a firing alert is amber. There is no blue here: this page has no gate,
  %% because the gate — the pull request a human merges — belongs to the alerting page.
  classDef store fill:#121820,stroke:#6b7885,stroke-width:2px,color:#e7edf3
  classDef warn fill:#262013,stroke:#a98a3c,stroke-width:2px,color:#ebe1c9

  class prom,loki store
  class am warn