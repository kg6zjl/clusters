flowchart TB
%% Three reasons a change exists, one gate, and two ways it is applied.

%% A change is only ever written by opening a pull request, and that pull request only counts once a
%% human merges it. What the merged diff then touches decides who applies it: a manifest goes
%% through Flux to the cluster, and a node-configuration change goes through Ansible to the machines.
%% Nothing here is a shell run on a host.

  subgraph byrequest["When I ask for a change"]
    ask["via Hermes,<br/>or a pull request<br/>I write myself"]
  end

  subgraph upstream["When something upstream moves"]
    renovate["Renovate<br/>proposes the version"]
  end

  subgraph machine["When a machine needs updating"]
    nodeconfig["a change to<br/>node configuration"]
  end

  pr["A pull request,<br/>merged by a human"]
  flux["Flux<br/>applies manifests"]
  ansible["Ansible<br/>runs the playbooks"]

  ask --> pr
  renovate --> pr
  nodeconfig --> pr

  pr -->|"touches the cluster"| flux
  pr -->|"touches the machines"| ansible

  %% Blue is the gate every change passes, green is where a merged change lands. The three reasons
  %% stay uncoloured: they are just three ways a pull request gets opened, not a ranking.
  classDef control fill:#121820,stroke:#71b7ff,stroke-width:2px,color:#e7edf3
  classDef ok fill:#17251d,stroke:#4f8f6a,stroke-width:2px,color:#dce9e0

  class pr control
  class flux,ansible ok