flowchart TB
%% The map: what is in here, grouped by the job it does rather than by namespace or vendor.
%% This is the figure the stack page hangs its table off, so a reader can answer "what do I need
%% for the job I'm doing?" without reading the table first.
%%
%% Deliberately not a flow chart. Only the arrows that are the actual design are drawn; everything
%% else is grouped by role and left unconnected, because an arrow here would be a claim about
%% causality that the pages behind this one make properly.
%%
%% The `direction LR` lines are layout, not meaning: they pack each group into a single row so the
%% diagram stays roughly 1000px wide instead of running to seven columns and shrinking to
%% illegibility on the page.
%%
%% Labels are kept to one or two words on purpose. The detail belongs in the table beside this
%% figure, and a diagram that carries the detail too is a diagram nobody reads.
%%
%% NOTE: the declaration must be line 1. Mermaid 11.x fails to parse a file that opens with a
%% %% comment block. See diagrams/README.md.

  subgraph truth["Source of truth"]
    direction LR
    git[("Git")] --> flux["Flux CD"]
  end

  subgraph runs["What runs"]
    direction LR
    fleet["the applications"] --- runtime["Longhorn · Traefik · MetalLB"]
  end

  subgraph keeps["What keeps the agent honest"]
    direction LR
    rbac["read-only RBAC"] --- kyverno["Kyverno"] --- netpol["NetworkPolicy"] --- prgate["the pull request"]
  end

  subgraph notices["What notices"]
    direction LR
    prom["Prometheus"] --- am["Alertmanager"] --- grafana["Grafana + Loki"]
  end

  subgraph acts["What acts"]
    direction LR
    agent["Hermes"] --- runners["CI runners"] --- renovate["Renovate"] --- ansible["Ansible"]
  end

  subgraph tells["Where it all reaches me"]
    direction LR
    discord["Discord channels"] --- ntfy["ntfy"]
  end

  %% A vertical spine. Without it Mermaid lays the six groups out side by side — nothing in the
  %% drawing forces one above the next — and the diagram ends up roughly twice as wide as the page,
  %% where it renders at about 9px. These are invisible: they constrain layout and assert nothing.
  truth ~~~ runs ~~~ keeps ~~~ notices ~~~ acts ~~~ tells

  flux -->|"applies"| fleet
  fleet --> prom
  prom --> am
  am --> discord
  am --> ntfy
  grafana -.->|"a dashboard per question"| me["me"]
  renovate -->|"opens a PR against"| prgate
  ansible -->|"reboots the hosts"| fleet
  runners --> prgate
  agent -->|"opens a PR against"| prgate

  classDef control fill:#121820,stroke:#71b7ff,stroke-width:2px,color:#e7edf3
  class rbac,kyverno,netpol,prgate control
